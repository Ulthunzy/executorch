if(NOT EXISTS "${MOE_NATIVE_BUILD}/NATIVE_TARGET.json")
  message(FATAL_ERROR "Missing NATIVE_TARGET.json; rebuild Native with the MoE build.sh")
endif()
file(READ "${MOE_NATIVE_BUILD}/NATIVE_TARGET.json" _native_target)
string(JSON _native_version GET "${_native_target}" version)
string(JSON _native_arch GET "${_native_target}" dsp_arch)
string(JSON _native_profile GET "${_native_target}" native_profile)
string(JSON _native_sdk GET "${_native_target}" qnn_sdk)
file(REAL_PATH "${QNN_SDK_ROOT}" _requested_sdk)
if(NOT _native_version EQUAL 1 OR NOT _native_arch STREQUAL "v${MOE_DSP_ARCH}")
  message(FATAL_ERROR "Native build architecture mismatch; rebuild Native for v${MOE_DSP_ARCH}")
endif()
string(JSON _prefill_mapped_io ERROR_VARIABLE _prefill_mapped_io_error GET "${_native_target}" prefill_mapped_io)
if(_prefill_mapped_io_error OR NOT _prefill_mapped_io EQUAL 2)
  message(FATAL_ERROR "Native prefill mapped-IO protocol mismatch; rebuild Native with this version of build.sh")
endif()
string(JSON _prefill_expert_stream ERROR_VARIABLE _prefill_expert_stream_error GET "${_native_target}" prefill_expert_stream)
if(_prefill_expert_stream_error OR NOT _prefill_expert_stream EQUAL 2)
  message(FATAL_ERROR "Native prefill expert-stream protocol mismatch: resident expert banks require version 2; rebuild Native with this version of build.sh")
endif()
if(DEFINED MOE_NATIVE_PROFILE AND NOT _native_profile STREQUAL "${MOE_NATIVE_PROFILE}")
  message(FATAL_ERROR "Native profiling configuration mismatch; rebuild Native")
endif()
if(NOT _native_sdk STREQUAL _requested_sdk)
  message(FATAL_ERROR "Native QNN SDK mismatch; rebuild Native with ${_requested_sdk}")
endif()
foreach(_artifact native-prefill/et_prefill_rpc.h native-prefill/et_prefill_rpc_stub.o
    native-decode/et_decode_rpc.h native-decode/et_decode_rpc_stub.o libet_qnnop.so)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MOE_NATIVE_BUILD}/${_artifact}")
  if(NOT EXISTS "${MOE_NATIVE_BUILD}/${_artifact}")
    message(FATAL_ERROR "Missing Native artifact ${_artifact}; rebuild Native")
  endif()
  string(JSON _expected_hash GET "${_native_target}" artifacts "${_artifact}")
  file(SHA256 "${MOE_NATIVE_BUILD}/${_artifact}" _actual_hash)
  if(NOT _actual_hash STREQUAL _expected_hash)
    message(FATAL_ERROR "Native artifact changed: ${_artifact}; rebuild Native")
  endif()
endforeach()
